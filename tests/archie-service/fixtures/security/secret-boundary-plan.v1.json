{
  "schema": "archie-secret-boundary-plan/v1",
  "planId": "secret_boundary_plan_fixture_001",
  "scanTargets": [
    {
      "targetId": "archie-service-fixtures",
      "targetClass": "fixture_json",
      "path": "tests/archie-service/fixtures",
      "required": true,
      "fileExtensions": [".json"]
    },
    {
      "targetId": "archie-service-browser-client",
      "targetClass": "browser_client",
      "path": "src/archie-service/browser-client",
      "required": true,
      "fileExtensions": [".mjs", ".js", ".ts"]
    },
    {
      "targetId": "archie-service-http-selector",
      "targetClass": "service_source",
      "path": "src/archie-service/http",
      "required": true,
      "fileExtensions": [".mjs", ".js", ".ts"]
    },
    {
      "targetId": "archie-service-static-output-candidate",
      "targetClass": "static_output_candidate",
      "path": "tests/archie-service/fixtures/static-output",
      "required": true,
      "fileExtensions": [".html", ".css", ".js", ".json"]
    }
  ],
  "forbiddenSecretClasses": [
    "provider_model_key",
    "github_token",
    "payment_secret",
    "database_secret",
    "signing_secret",
    "monitoring_secret",
    "browser_model_key",
    "provider_payload_secret",
    "private_prompt_expansion"
  ],
  "allowedSecretReferenceSuffix": "_SECRET_REF",
  "requiresNoWrite": true,
  "requiresNoBrowserModelKeys": true,
  "requiresNoProviderPayloadSecrets": true,
  "requiresNoPrivatePromptExpansion": true
}
