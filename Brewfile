# Project dependencies for macOS. Usage and scope: README.md#macos-dependencies
# Keep this curated; do not replace it with a dump of a personal machine.

# Local server, generators, and checks; Node major matches GitHub CI.
brew "node@22"
brew "ripgrep"

# Interpreter for the shared venv; Python packages live in requirements.txt.
brew "python@3.13"

# EOM solver: src/eom/CMakeLists.txt requires these build tools/libraries.
brew "cmake"
brew "boost"
brew "gmp"
brew "mpfr"

# Textbook PDF merging, text extraction, and rendering for visual inspection.
brew "poppler"
