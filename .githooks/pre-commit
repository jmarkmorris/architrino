#!/usr/bin/env bash
set -euo pipefail

current_branch="$(git symbolic-ref --quiet --short HEAD || true)"
if [[ "${ALLOW_MAIN_COMMIT:-}" != "1" && "$current_branch" == "main" ]]; then
  echo "[pre-commit] direct commits on 'main' are blocked."
  echo "[pre-commit] create a feature branch, commit there, and merge via PR."
  echo "[pre-commit] override once with: ALLOW_MAIN_COMMIT=1 git commit ..."
  exit 1
fi

if node scripts/pr-validation-receipt.mjs verify --base origin/main; then
  echo "[pre-commit] reusing exact-state validation receipt."
else
  echo "[pre-commit] validation receipt unavailable; running full PR gate."
  node scripts/pr-validation-receipt.mjs run --base origin/main
fi
