          "selector": {
            "kind": "literal",
            "text": "**Finite-ledger scalar-superposition theorem (conditional derivation).** Fix the retained histories, root selections, regularization, and boundary convention of that chart. If every row $b\\in\\mathcal B$ has a differentiable receiver-local scalar representative $\\Phi_b$ on the same chart satisfying"
          },
          "contract": "fixed-byte-selection/v1",
          "sha256": "d970a0c4857d818258506688e2f3c58661bb520825482efdb2b28dd86d879689"
        }
      ],
      "scope": "Finite number of differentiable row scalars on one shared chart with fixed histories, selected roots, regularization and boundary convention."
    },
