+    unadmitted("charge-not-a-number", "\"id\":\"receiver\",\"charge\":\"1\"",
+               "\"id\":\"receiver\",\"charge\":\"not-a-number\"");
+    unadmitted("coupling-beyond-binary64", "\"coupling\":\"0.001\"",
