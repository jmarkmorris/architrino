+// Admission of an origin by the driver itself: a zero-length call of the
+// real entry point, which applies its whole request and population domain
+// and takes no step. Empty when admitted; otherwise the reason. This is the
+// only admission this unit uses, so that a record's origin and controls are
+// admitted by exactly the rules that would govern its first leg.
+std::string origin_admission_refusal(const ValidatedEvolutionRequest& origin) {
+  ValidatedEvolutionRequest probe = origin;
+  probe.end_time = origin.start_time;
+  probe.cancellation_requested = {};
+  probe.accepted_step_callback = {};
+  try {
+    const ValidatedEvolutionCertificate certificate =
+        evolve_validated_far_step_histories(probe);
+    if (certificate.continuation == nullptr) {
+      return certificate.run.halt_code + ": " + certificate.halt_reason;
+    }
+    if (certificate.run.status != "completed" ||
+        certificate.run.accepted_step_count != 0U ||
+        certificate.evidence != nullptr) {
+      return "the driver did not admit the origin as a zero-length run";
+    }
+  } catch (const std::exception& error) {
+    return error.what();
+  }
+  return {};
+}
