+  if (translated.evidence != nullptr) return {nullptr, "not_an_origin"};
+  for (const auto& path : translated.paths) {
+    if (path.history.uniform_circular_endpoint_certificate().has_value()) {
+      return {nullptr, "not_an_origin"};
