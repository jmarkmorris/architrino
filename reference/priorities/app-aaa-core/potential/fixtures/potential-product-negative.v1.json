      "expectedCode": "incompatible_scales"
    },
    {
      "id": "unsupported-precision",
      "mutation": {"path": "request.numericPolicy.precisionBits", "value": 128},
      "expectedCode": "unsupported_precision"
    },
    {
      "id": "incomplete-sealed-publication",
      "mutation": {"path": "publication.coverage.complete", "value": false},
      "expectedCode": "incomplete_publication"
    },
    {
      "id": "unknown-observable-version",
      "mutation": {"path": "request.observable.version", "value": "synthetic_scalar_potential/v999"},
      "expectedCode": "unknown_observable_version"
