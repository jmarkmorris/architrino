diff --git a/.githooks/pre-commit b/.githooks/pre-commit
index 10c4f0c9f..5b07cd58e 100755
--- a/.githooks/pre-commit
+++ b/.githooks/pre-commit
@@ -1,6 +1,12 @@
 #!/usr/bin/env bash
 set -euo pipefail
 
+# Git exports GIT_DIR and GIT_WORK_TREE to hooks when it was invoked with
+# --git-dir/--work-tree or with GIT_DIR set. Any `git init` or `git config` run
+# in another directory by the checks below would then act on THIS repository
+# (measured 2026-09-06: test fixtures rewrote user.name and core.hooksPath).
+unset GIT_DIR GIT_WORK_TREE
+
 current_branch="$(git symbolic-ref --quiet --short HEAD || true)"
 if [[ "${ALLOW_MAIN_COMMIT:-}" != "1" && "$current_branch" == "main" ]]; then
   echo "[pre-commit] direct commits on 'main' are blocked."
