+void discard_warm_root_cells(
+    NativeAccelerationSnapshotCertificate& snapshot) {
+  for (auto& row : snapshot.root_certificates) {
+    std::vector<NativeRootFreeCell>().swap(row.certificate.root_free_cells);
+  }
