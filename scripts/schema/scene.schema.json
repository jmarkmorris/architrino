{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/schema/scene.schema.json",
  "title": "Architrino Scene File",
  "type": "object",
  "required": ["scene", "objects"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": ["string", "number"]
    },
    "scene": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "units": { "type": "string" },
        "scaleBandLog10m": {
          "type": ["number", "array"],
          "items": { "type": "number" }
        },
        "hideScaleLabels": { "type": "boolean" },
        "wrapLabels": { "type": "boolean" },
        "centerOn": { "type": "string" },
        "layoutMode": {
          "type": "string",
          "enum": ["manual", "ring", "grid"]
        },
        "layoutColumns": { "type": "integer", "minimum": 1 },
        "sphereColorScheme": { "type": "string" },
        "markdownPath": { "type": "string" },
        "markdownSection": { "type": "string" },
        "markdownColumns": { "type": "number" },
        "markdownAutoOpen": { "type": "boolean" },
        "autoSphereRing": { "type": "boolean" },
        "autoMarkdownPath": { "type": "string" },
        "autoMarkdownDirectory": { "type": "string" },
        "autoMarkdownSection": { "type": "string" },
        "autoMarkdownHeadingLevel": { "type": "number" },
        "autoMarkdownIncludeExistingInLayout": { "type": "boolean" },
        "autoMarkdownNodeRadius": { "type": "number" },
        "autoMarkdownRingRadius": { "type": "number" },
        "autoMarkdownMaxRingCount": { "type": "number" },
        "autoMarkdownGridSpacing": { "type": "number" },
        "autoMarkdownColumns": { "type": "number" },
        "autoMarkdownColor": { "type": "string" },
        "autoMarkdownSubdirectories": { "type": "boolean" },
        "autoMarkdownExcludePaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoMarkdownIndexPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoMarkdownPlainPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoMarkdownPlainSectionPaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoMarkdownPalette": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoMarkdownPaletteName": { "type": "string" },
        "markdown": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["file", "directory"]
                },
                "path": { "type": "string" },
                "subdirectories": { "type": "boolean" }
              }
            },
            "layout": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "includeExisting": { "type": "boolean" },
                "nodeRadius": { "type": "number" },
                "ringRadius": { "type": "number" },
                "maxRingCount": { "type": "number" },
                "gridSpacing": { "type": "number" },
                "palette": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "paletteName": { "type": "string" },
                "color": { "type": "string" }
              }
            },
            "render": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "defaultMode": {
                  "type": "string",
                  "enum": ["doc", "index"]
                },
                "headingLevel": { "type": "number" },
                "sectionDepth": { "type": "number" },
                "columns": { "type": "number" }
              }
            },
            "exclude": {
              "type": "array",
              "items": { "type": "string" }
            },
            "overrides": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path"],
                "additionalProperties": true,
                "properties": {
                  "path": { "type": "string" },
                  "mode": {
                    "type": "string",
                    "enum": ["doc", "index"]
                  },
                  "headingLevel": { "type": "number" },
                  "sectionDepth": { "type": "number" },
                  "columns": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "radius", "color"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string" },
          "radius": { "type": "number", "minimum": 0 },
          "color": { "type": "string", "minLength": 1 },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "fixedPosition": { "type": "boolean" },
          "subScenes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "markdownPath": { "type": "string" },
          "markdownSection": { "type": "string" },
          "markdownColumns": { "type": "number" },
          "markdownHeadingLevel": { "type": "number" },
          "markdownAutoIndex": { "type": "boolean" },
          "markdownPlainSectionPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scaleExponent": { "type": "number" },
          "hideScaleLabel": { "type": "boolean" },
          "category": { "type": "string" },
          "reaction": { "type": "string" },
          "role": { "type": "string" },
          "renderStyle": { "type": "string" },
          "motion": { "type": "object" },
          "details": { "type": "object" },
          "shell": { "type": ["object", "number", "string", "array"] },
          "binaryBands": {
            "type": "array",
            "items": { "type": ["object", "string", "number", "array"] }
          },
          "glowRing": { "type": "boolean" },
          "glowRingColor": { "type": "string" },
          "glowRingOpacity": { "type": "number" },
          "glowRingThickness": { "type": "number" },
          "glowRingScale": { "type": "number" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" }
        }
      }
    }
  }
}
