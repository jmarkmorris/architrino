{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/schema/scene.schema.json",
  "title": "Architrino Scene File",
  "type": "object",
  "required": ["scene", "objects"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["subScenes"] },
                  { "required": ["markdownPath"] }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": ["string", "number"]
    },
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        { "required": ["id", "title", "type", "layout"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "Scene-Index",
            "Scene-Markdown-View",
            "Scene-Markdown-Split",
            "Scene-Diagram",
            "Scene-Animation"
          ]
        },
        "units": { "type": "string" },
        "scaleBandLog10m": {
          "type": ["number", "array"],
          "items": { "type": "number" }
        },
        "hideScaleLabels": { "type": "boolean" },
        "wrapLabels": { "type": "boolean" },
        "centerOn": { "type": "string" },
        "layoutColumns": { "type": "integer", "minimum": 1 },
        "sphereColorScheme": { "type": "string" },
        "layout": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "columns": { "type": "number" },
            "autoOpen": { "type": "boolean" },
            "section": { "type": "string" }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [
          { "required": ["id"] },
          {
            "anyOf": [
              { "required": ["label"] },
              { "required": ["title"] }
            ]
          }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string" },
          "labelTitle": { "type": "string" },
          "labelSubtitle": { "type": "string" },
          "labelDates": { "type": "string" },
          "labelBadge": { "type": "string" },
          "labelBadgeImage": { "type": "string" },
          "labelBadgeAlt": { "type": "string" },
          "radius": { "type": "number", "minimum": 0 },
          "color": { "type": "string", "minLength": 1 },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "fixedPosition": { "type": "boolean" },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sceneId": { "type": "string" },
                "scenePath": { "type": "string" },
                "slot": { "type": "string" }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "type": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "view": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "columns": { "type": "number" },
              "section": { "type": "string" },
              "autoOpen": { "type": "boolean" }
            }
          },
          "markdownHeadingLevel": { "type": "number" },
          "markdownAutoIndex": { "type": "boolean" },
          "markdownPlainSectionPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scaleExponent": { "type": "number" },
          "hideScaleLabel": { "type": "boolean" },
          "category": { "type": "string" },
          "reaction": { "type": "string" },
          "role": { "type": "string" },
          "renderStyle": { "type": "string" },
          "motion": { "type": "object" },
          "details": { "type": "object" },
          "shell": { "type": ["object", "number", "string", "array"] },
          "binaryBands": {
            "type": "array",
            "items": { "type": ["object", "string", "number", "array"] }
          },
          "glowRing": { "type": "boolean" },
          "glowRingColor": { "type": "string" },
          "glowRingOpacity": { "type": "number" },
          "glowRingThickness": { "type": "number" },
          "glowRingScale": { "type": "number" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" }
        }
      }
    }
  }
}
