{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/schema/scene.schema.json",
  "title": "Architrino Scene File",
  "type": "object",
  "required": ["scene", "objects"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "not": {
              "anyOf": [
                { "required": ["kind"] },
                { "required": ["layoutMode"] },
                { "required": ["autoMarkdownPath"] },
                { "required": ["autoMarkdownSection"] },
                { "required": ["autoMarkdownHeadingLevel"] },
                { "required": ["autoMarkdownColumns"] },
                { "required": ["autoMarkdownSectionDepth"] },
                { "required": ["autoMarkdownIncludeExistingInLayout"] },
                { "required": ["autoMarkdownNodeRadius"] },
                { "required": ["autoMarkdownRingRadius"] },
                { "required": ["autoMarkdownMaxRingCount"] },
                { "required": ["autoMarkdownGridSpacing"] },
                { "required": ["autoMarkdownPalette"] },
                { "required": ["autoMarkdownPaletteName"] },
                { "required": ["autoMarkdownColor"] },
                { "required": ["autoMarkdownExcludePaths"] },
                { "required": ["autoMarkdownPlainPaths"] },
                { "required": ["autoMarkdownDefaultIndex"] },
                { "required": ["autoMarkdownIndexPaths"] },
                { "required": ["autoMarkdownPlainSectionPaths"] },
                { "required": ["autoMarkdownOverrides"] }
              ]
            }
          },
          "objects": {
            "items": {
              "not": {
                "anyOf": [
                  { "required": ["subScenes"] },
                  { "required": ["markdownPath"] }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "required": ["type"]
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "items": {
              "not": {
                "required": ["children"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "properties": {
              "type": { "const": "Scene-Index" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "required": ["children"],
            "not": {
              "anyOf": [
                { "required": ["source"] },
                { "required": ["view"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "properties": {
              "type": { "const": "Scene-Markdown-View" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "required": ["source"],
            "properties": {
              "source": {
                "required": ["type", "path"],
                "properties": {
                  "type": { "const": "markdown" }
                },
                "not": {
                  "anyOf": [
                    { "required": ["split"] },
                    { "required": ["tree"] }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "properties": {
              "type": { "const": "Scene-Markdown-Split" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "required": ["source"],
            "properties": {
              "source": {
                "required": ["type", "path", "split"],
                "properties": {
                  "type": { "const": "markdown" }
                },
                "not": {
                  "required": ["tree"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "type": "object",
            "properties": {
              "type": { "const": "Scene-Markdown-Tree" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "required": ["source"],
            "properties": {
              "source": {
                "required": ["type", "path", "tree"],
                "properties": {
                  "type": { "const": "markdown" },
                  "tree": {
                    "required": ["rootHeadingLevel", "maxDepth"]
                  }
                },
                "not": {
                  "required": ["split"]
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": ["string", "number"]
    },
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        { "required": ["id", "title", "type", "layout"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "Scene-Index",
            "Scene-Markdown-View",
            "Scene-Markdown-Split",
            "Scene-Markdown-Tree",
            "Scene-Diagram",
            "Scene-Animation"
          ]
        },
        "units": { "type": "string" },
        "scaleBandLog10m": {
          "type": ["number", "array"],
          "items": { "type": "number" }
        },
        "wrapLabels": { "type": "boolean" },
        "centerOn": { "type": "string" },
        "layoutColumns": { "type": "integer", "minimum": 1 },
        "sphereColorScheme": { "type": "string" },
        "layout": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "centerNode": { "type": ["string", "null"] },
            "centerOn": { "type": "string" },
            "direction": {
              "type": "string",
              "enum": ["clockwise", "counterclockwise"]
            },
            "order": {
              "type": "string",
              "enum": ["objects"]
            },
            "allowInnerRings": { "type": "boolean" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "path": { "type": "string" },
            "split": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "headingLevel": { "type": "number" },
                "sectionDepth": { "type": "number" },
                "maxDepth": { "type": "number" },
                "section": { "type": "string" },
                "nodeRadius": { "type": "number", "exclusiveMinimum": 0 },
                "ringRadius": { "type": "number", "exclusiveMinimum": 0 },
                "maxRingCount": { "type": "number", "exclusiveMinimum": 0 },
                "gridSpacing": { "type": "number", "exclusiveMinimum": 0 },
                "gridGapMultiplier": { "type": "number", "exclusiveMinimum": 0 },
                "overrides": { "type": "object" }
              }
            },
            "tree": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "rootHeadingLevel": { "type": "number" },
                "maxDepth": { "type": "number" },
                "section": { "type": "string" },
                "overrides": { "type": "object" }
              }
            }
          }
        },
        "view": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "columns": { "type": "number" },
            "autoOpen": { "type": "boolean" },
            "section": { "type": "string" },
            "headingLevel": { "type": "number" },
            "sectionDepth": { "type": "number" },
            "maxDepth": { "type": "number" }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["nodeId"],
            "anyOf": [
              { "required": ["scenePath"] },
              { "required": ["sceneId"] }
            ],
            "properties": {
              "nodeId": { "type": "string", "minLength": 1 },
              "sceneId": { "type": "string" },
              "scenePath": { "type": "string" },
              "title": { "type": "string" },
              "labelBadge": { "type": "string" },
              "slot": { "type": "string" },
              "color": { "type": "string" }
            }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [
          { "required": ["id"] },
          {
            "anyOf": [
              { "required": ["label"] },
              { "required": ["title"] }
            ]
          }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string" },
          "labelTitle": { "type": "string" },
          "labelSubtitle": { "type": "string" },
          "labelDates": { "type": "string" },
          "labelBadge": { "type": "string" },
          "labelBadgeImage": { "type": "string" },
          "labelBadgeAlt": { "type": "string" },
          "radius": { "type": "number", "minimum": 0 },
          "color": { "type": "string", "minLength": 1 },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number" }
          },
          "fixedPosition": { "type": "boolean" },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "sceneId": { "type": "string" },
                "scenePath": { "type": "string" },
                "slot": { "type": "string" }
              }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "type": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "view": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "columns": { "type": "number" },
              "section": { "type": "string" },
              "autoOpen": { "type": "boolean" }
            }
          },
          "markdownHeadingLevel": { "type": "number" },
          "markdownMaxDepth": { "type": "number" },
          "markdownAutoIndex": { "type": "boolean" },
          "markdownPlainSectionPaths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "category": { "type": "string" },
          "reaction": { "type": "string" },
          "role": { "type": "string" },
          "renderStyle": { "type": "string" },
          "motion": { "type": "object" },
          "details": { "type": "object" },
          "shell": { "type": ["object", "number", "string", "array"] },
          "binaryBands": {
            "type": "array",
            "items": { "type": ["object", "string", "number", "array"] }
          },
          "glowRing": { "type": "boolean" },
          "glowRingColor": { "type": "string" },
          "glowRingOpacity": { "type": "number" },
          "glowRingThickness": { "type": "number" },
          "glowRingScale": { "type": "number" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "type": "string" }
        }
      }
    }
  }
}
