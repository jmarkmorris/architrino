{
  "schema": "aaa-foundational-impact-contracts/v1",
  "description": "Diff-routing manifest for foundational AAA contracts. A contract is an equation, postulate, sign convention, normalization, or ontology rule that downstream proofs, simulations, applications, or validation gates consume.",
  "severityWeights": {
    "P0": 5,
    "P1": 3,
    "P2": 1
