    {
      "id": "master-equation.causal-root-geometry",
      "title": "Master Equation causal-root geometry",
      "severity": "P0",
      "rationale": "The causal-hit constraint, emission-root selection, and delayed separation convention feed the EOM engine, proof programs, simulations, photon app, and causal-delay app.",
      "pathTriggers": [
        "content/markdown/aaa/dynamics/master-equation.md",
        "content/markdown/aaa/foundations/architrino.md",
        "content/markdown/aaa/foundations/absolute-time.md",
        "content/markdown/aaa/validation/simulations/action-energy/**",
        "src/eom/**",
        "src/apps/animator/display/**",
        "src/apps/causal-delay-feedback/**",
        "scripts/simulations/**"
      ],
      "textTriggers": [
        { "type": "literal", "value": "Master Equation" },
        { "type": "literal", "value": "F_{ij}" },
        { "type": "literal", "value": "F_a" },
        { "type": "literal", "value": "T_{\\mathrm{em}}" },
        { "type": "literal", "value": "causal root" },
        { "type": "literal", "value": "delayed separation" },
        { "type": "literal", "value": "self-hit" },
        { "type": "literal", "value": "self-reception" },
        { "type": "regex", "value": "\\bcausal[- ]delay\\b" }
      ],
      "consumers": {
        "proofPrograms": [
          "prescribed-path causal-root analysis"
        ],
        "simulations": [
          "action-energy delayed dynamics",
          "causal-delay feedback runtime"
        ],
        "applications": [
          "Photon app",
          "Causal Delay Feedback app",
          "Animator delayed-hit records"
        ],
        "validation": [
          "strict content indexes",
          "transmitter-factor clean slate"
        ]
      },
      "reevaluation": {
        "validation": [
          {
            "command": "node scripts/validate-content.mjs --check --strict",
            "reason": "Catch markdown/index drift after source equation or foundation prose changes."
          },
          {
            "command": "node scripts/check-transmitter-factor-clean-slate.mjs",
            "reason": "Catch stale receiver-playback acceleration wording and transmitter-side implementation drift."
          }
        ],
        "proofPrograms": [
          {
            "command": "node --test tests/prescribed-orbit-causal-roots.test.js",
            "reason": "Recheck prescribed-path causal-root analysis surfaces."
          }
        ],
        "simulations": [
          {
            "command": "node --test tests/prescribed-orbit-causal-roots.test.js tests/causal-delay-feedback-runtime.test.js",
            "reason": "Recheck delayed-root simulation and runtime surfaces."
          }
        ],
        "applications": [
          {
            "command": "node --test tests/photon-runtime.test.js tests/causal-delay-feedback-eom-replay-adapter.test.js",
            "reason": "Recheck application surfaces that display delayed-hit or Master Equation state."
          }
        ]
      }
    },
