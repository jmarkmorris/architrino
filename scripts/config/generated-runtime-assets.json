{
  "schema": "architrino/generated-runtime-assets.v1",
  "families": [
    {
      "id": "borg-catalog",
      "path": "content/generated/borg/assembly-record-catalog.v2.js",
      "command": ["scripts/borg/build-assembly-record-catalog.mjs", "--write"]
    },
    {
      "id": "borg-budget-identities",
      "path": "content/generated/borg/certified-budget-identities.v1.js",
      "command": ["scripts/borg/build-certified-budget-identities.mjs", "--write"]
    },
    {
      "id": "borg-records",
      "directory": "content/assets/borg/records",
      "command": ["scripts/eom/generate-prescribed-braid-record.mjs", "--all", "--write"]
    },
    {
      "id": "equation-corpus",
      "path": "content/generated/equation-mapping/corpus-equations.json",
      "command": ["scripts/build-equation-mapping-corpus.mjs", "--build"]
    },
    {
      "id": "full-corpus-index",
      "path": "content/generated/source-index/local-full-corpus-snapshot.v1.json",
      "command": ["scripts/archie-service/build-full-corpus-source-index.mjs", "--write"]
    },
    {
      "id": "reference-surface",
      "path": "content/generated/reference/reference-surface.v1.json",
      "command": ["scripts/build-reference-surface.mjs", "--write"]
    }
  ]
}
