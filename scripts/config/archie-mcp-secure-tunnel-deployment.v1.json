{
  "schema": "archie-mcp-secure-tunnel-deployment/v1",
  "deploymentClass": "private_outbound_only",
  "publicRemoteContractAdvanced": false,
  "provider": "openai_secure_mcp_tunnel",
  "officialGuide": "https://developers.openai.com/api/docs/guides/secure-mcp-tunnels",
  "clientRelease": {
    "repository": "https://github.com/openai/tunnel-client",
    "tag": "v0.0.14",
    "versionPrefix": "0.0.14+",
    "platforms": {
      "darwin-arm64": {
        "archiveName": "tunnel-client-v0.0.14-darwin-arm64.zip",
        "archiveUrl": "https://github.com/openai/tunnel-client/releases/download/v0.0.14/tunnel-client-v0.0.14-darwin-arm64.zip",
        "archiveSha256": "b540493c5bdbcdbb755700c8e2e16597e28b1569e425007e0f73111047bd6a64",
        "executableSha256": "309fd85da5a8c2ca8dae920deea8ac10a4d7934ed18ac46e7df0c200139cc9c5"
      }
    }
  },
  "controlPlane": {
    "baseUrl": "https://api.openai.com",
    "tunnelIdEnvironmentVariable": "OPENAI_MCP_TUNNEL_ID",
    "runtimeApiKeyEnvironmentVariable": "OPENAI_MCP_TUNNEL_API_KEY",
    "runtimeApiKeyReference": "env:OPENAI_MCP_TUNNEL_API_KEY"
  },
  "runtime": {
    "alias": "architrino-full-corpus",
    "profile": "architrino-full-corpus",
    "profileDirectory": ".local-data/archie-mcp-tunnel/profiles",
    "stateDirectory": ".local-data/archie-mcp-tunnel/xdg",
    "receiptPath": ".local-data/archie-mcp-tunnel/local-runtime-receipt.json",
    "healthListenAddress": "127.0.0.1:0",
    "openBrowser": false,
    "managedRuntime": true,
    "transport": "stdio",
    "launcher": "scripts/archie-service/run-full-corpus-mcp-server.mjs"
  },
  "release": {
    "acceptedBranch": "main",
    "requiresExactRemoteMain": true,
    "requiresCleanTrackedTree": true,
    "requiresContentIntegrity": true,
    "requiresFreshFullCorpusSnapshot": true,
    "requiresFullCorpusProtocolSmoke": true
  },
  "capabilityBoundary": {
    "tools": [
      "search",
      "read",
      "topics",
      "neighbors",
      "walk"
    ],
    "accessScope": "public",
    "readOnly": true,
    "hiddenMaterialAllowed": false,
    "claimAuthorityRaised": false,
    "repositoryWritesAllowed": false,
    "inboundListenerAllowed": false,
    "publicEndpointCreated": false
  }
}
