{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/xyzzy/v1/schema.json",
  "title": "Xyzzy Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assemblies",
    "operators",
    "links",
    "compositeLabels"
  ],
  "properties": {
    "schema": {
      "const": "xyzzy/v1"
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "title",
          "role",
          "tiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "reactant",
              "intermediate",
              "product"
            ]
          },
          "tiles": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "title",
          "positrinoCount",
          "electrinoCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "positrinoCount": {
            "type": "integer",
            "minimum": 0
          },
          "electrinoCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "endpointA",
          "endpointB"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "endpointA": {
            "type": "string",
            "minLength": 1
          },
          "endpointB": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compositeLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "side",
          "text",
          "rowStart",
          "rowEnd"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rowStart": {
            "type": "integer",
            "minimum": 0
          },
          "rowEnd": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
