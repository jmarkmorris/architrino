{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/combo-publication-graph/v1/schema.json",
  "title": "Combo Publication Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "units", "edges"],
  "properties": {
    "schema": {
      "const": "combo-publication-graph/v1"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "lane",
          "recipeId",
          "occurrenceKey",
          "title",
          "anchorRow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["assembly", "operator"]
          },
          "lane": {
            "type": "integer",
            "minimum": 1
          },
          "recipeId": {
            "type": "string",
            "minLength": 1
          },
          "occurrenceKey": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "anchorRow": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromUnitId",
          "fromPortId",
          "toUnitId",
          "toPortId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "fromUnitId": {
            "type": "string",
            "minLength": 1
          },
          "fromPortId": {
            "type": "string",
            "minLength": 1
          },
          "toUnitId": {
            "type": "string",
            "minLength": 1
          },
          "toPortId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
