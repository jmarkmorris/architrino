{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/solver-request/v1/schema.json",
  "title": "Solver Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "participants",
    "manualOperators",
    "manualMappings",
    "dissociation",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "solver-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceKind"],
      "properties": {
        "sourceKind": {
          "type": "string",
          "enum": ["reaction", "cli", "pdg-ingest", "fixture"]
        },
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "upstreamContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSchema", "reviewBoundary"],
      "properties": {
        "sourceSchema": {
          "type": "string",
          "minLength": 1
        },
        "proposalId": {
          "type": "string",
          "minLength": 1
        },
        "reviewBoundary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": true
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upstreamSchema",
            "downstreamSchema",
            "handoffMode",
            "reactionAcceptanceRequired",
            "reactionAcceptanceBoundary",
            "acceptedReactionHandoff",
            "composerHandoff"
          ],
          "properties": {
            "upstreamSchema": {
              "type": "string",
              "minLength": 1
            },
            "downstreamSchema": {
              "type": "string",
              "minLength": 1
            },
            "handoffMode": {
              "type": "string",
              "minLength": 1
            },
            "reactionAcceptanceRequired": {
              "type": "boolean"
            },
            "reactionAcceptanceBoundary": {
              "type": "string",
              "minLength": 1
            },
            "acceptedReactionHandoff": {
              "type": "string",
              "minLength": 1
            },
            "composerHandoff": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rank", "score", "reasons"],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 0
            },
            "score": {
              "type": "number"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "side",
          "templateId",
          "label",
          "inventory",
          "rootNodeId",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": ["reactant", "product", "center"]
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placementClass", "row"],
            "properties": {
              "placementClass": {
                "type": "string",
                "enum": ["reactant", "product", "center"]
              },
              "row": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "centerUsage": {
            "type": "string",
            "enum": ["optional", "required"]
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "type": "string",
            "minLength": 1
          },
          "isComposite": {
            "type": "boolean"
          },
          "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["electrinoCount", "positrinoCount"],
            "properties": {
              "electrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "positrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "familyCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["family", "count"],
                  "properties": {
                    "family": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "coreFormCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["form", "count"],
                  "properties": {
                    "form": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "rootNodeId": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "templateId", "label", "inventory"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "parentId": {
                  "type": "string",
                  "minLength": 1
                },
                "templateId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "polarity": {
                  "type": "string",
                  "minLength": 1
                },
                "isComposite": {
                  "type": "boolean"
                },
                "inventory": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["electrinoCount", "positrinoCount"],
                  "properties": {
                    "electrinoCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "positrinoCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "familyCounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["family", "count"],
                        "properties": {
                          "family": {
                            "type": "string",
                            "minLength": 1
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "coreFormCounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["form", "count"],
                        "properties": {
                          "form": {
                            "type": "string",
                            "minLength": 1
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "manualOperators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "inputs", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["associate", "dissociate"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["participantId", "anchorId", "role"],
              "properties": {
                "participantId": {
                  "type": "string",
                  "minLength": 1
                },
                "anchorId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
                },
                "anchorInstanceIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["participantId", "anchorId", "role"],
              "properties": {
                "participantId": {
                  "type": "string",
                  "minLength": 1
                },
                "anchorId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
                },
                "anchorInstanceIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane", "row", "slot"],
            "properties": {
              "lane": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "slot": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "manualMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "from", "to", "provenanceMode", "conservedLedger"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["direct", "fragment", "operator-path"]
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "anchorId", "role"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "anchorId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
              },
              "anchorInstanceIndex": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "anchorId", "role"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "anchorId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
              },
              "anchorInstanceIndex": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "viaOperatorId": {
            "type": "string",
            "minLength": 1
          },
          "provenanceMode": {
            "type": "string",
            "enum": ["manual-authored", "manual-inferred"]
          },
          "conservedLedger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["electrinoCount", "positrinoCount"],
            "properties": {
              "electrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "positrinoCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "dissociation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manuallyOpenedParticipantIds",
        "manuallyOpenedNodeIds",
        "preserveManualState"
      ],
      "properties": {
        "manuallyOpenedParticipantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manuallyOpenedNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserveManualState": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recruitmentMode",
        "lateBosonCollapseMode",
        "weakChannelMode",
        "carryThroughMode"
      ],
      "properties": {
        "recruitmentMode": {
          "type": "string",
          "enum": ["forbid", "allow-if-needed"]
        },
        "lateBosonCollapseMode": {
          "type": "string",
          "enum": ["forbid", "allow-exact"]
        },
        "weakChannelMode": {
          "type": "string",
          "enum": ["v1-core-provenance-only"]
        },
        "carryThroughMode": {
          "type": "string",
          "enum": ["exact-first"]
        }
      }
    }
  }
}
