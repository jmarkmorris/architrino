{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgsolve-result/v1/schema.json",
  "title": "pdgsolve Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problemId",
    "searchStatus",
    "bestFamilyId",
    "acceptedFamilyId",
    "diagnostics",
    "optionFamilies",
    "review",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "pdgsolve-result/v1"
    },
    "problemId": {
      "type": "string",
      "minLength": 1
    },
    "searchStatus": {
      "type": "string",
      "enum": ["exact_available", "partial_only", "unsupported"]
    },
    "bestFamilyId": {
      "type": "string",
      "minLength": 1
    },
    "acceptedFamilyId": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "message", "blocking", "payload"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "payload": { "type": "object" }
        }
      }
    },
    "optionFamilies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "familyId",
          "kind",
          "score",
          "augmentation",
          "laneInventories",
          "lane2Operators",
          "lane4Operators",
          "provenanceSummary",
          "diagnostics",
          "rawBranchCount",
          "publicationReady",
          "canonicalCandidate"
        ],
        "properties": {
          "familyId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["exact", "partial", "unsupported"]
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exactness",
              "primitiveMismatch",
              "middleMismatch",
              "auxiliaryBurden",
              "nonIdentityOperatorCount",
              "dissociationCount",
              "ambiguityPenalty",
              "tieBreakKey"
            ],
            "properties": {
              "exactness": { "type": "integer", "minimum": 0 },
              "primitiveMismatch": { "type": "integer", "minimum": 0 },
              "middleMismatch": { "type": "integer", "minimum": 0 },
              "auxiliaryBurden": { "type": "integer", "minimum": 0 },
              "nonIdentityOperatorCount": { "type": "integer", "minimum": 0 },
              "dissociationCount": { "type": "integer", "minimum": 0 },
              "ambiguityPenalty": { "type": "integer", "minimum": 0 },
              "tieBreakKey": { "type": "string", "minLength": 1 }
            }
          },
          "augmentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": {
                "type": "string",
                "enum": ["none", "2h", "4h"]
              },
              "right": {
                "type": "string",
                "enum": ["none", "2h", "4h"]
              }
            }
          },
          "laneInventories": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lane1", "lane3", "lane5"],
            "properties": {
              "lane1": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["assemblyId", "count"],
                  "properties": {
                    "assemblyId": { "type": "string", "minLength": 1 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "lane3": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["assemblyId", "count"],
                  "properties": {
                    "assemblyId": { "type": "string", "minLength": 1 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "lane5": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["assemblyId", "count"],
                  "properties": {
                    "assemblyId": { "type": "string", "minLength": 1 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          "lane2Operators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "lawId", "inputOccurrenceKeys", "outputOccurrenceKeys"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["associate", "dissociate", "pass-thru"] },
                "lawId": { "type": ["string", "null"], "minLength": 1 },
                "requiredSupportRows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["rowAssemblyId", "count"],
                    "properties": {
                      "rowAssemblyId": { "type": "string", "minLength": 1 },
                      "count": { "type": "integer", "minimum": 0 }
                    }
                  }
                },
                "inputOccurrenceKeys": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "outputOccurrenceKeys": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "lane4Operators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "lawId", "inputOccurrenceKeys", "outputOccurrenceKeys"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["associate", "dissociate", "pass-thru"] },
                "lawId": { "type": ["string", "null"], "minLength": 1 },
                "inputOccurrenceKeys": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "outputOccurrenceKeys": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "provenanceSummary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summaryText", "outputs"],
            "properties": {
              "summaryText": {
                "type": "string",
                "minLength": 1
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["occurrenceKey", "provenanceClass", "supportSourceRows", "ambiguous"],
                  "properties": {
                    "occurrenceKey": { "type": "string", "minLength": 1 },
                    "provenanceClass": {
                      "type": "string",
                      "enum": ["pass_thru", "active_rewrite", "support_derived", "mixed"]
                    },
                    "supportSourceRows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["rowAssemblyId", "count"],
                        "properties": {
                          "rowAssemblyId": { "type": "string", "minLength": 1 },
                          "count": { "type": "integer", "minimum": 0 }
                        }
                      }
                    },
                    "ambiguous": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "phase", "message", "blocking", "payload"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 },
                "blocking": { "type": "boolean" },
                "payload": { "type": "object" }
              }
            }
          },
          "rawBranchCount": {
            "type": "integer",
            "minimum": 0
          },
          "publicationReady": {
            "type": "boolean"
          },
          "canonicalCandidate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidateId",
              "exact",
              "laneInventories",
              "lane2Operators",
              "lane4Operators",
              "provenanceSummary",
              "solveGraph"
            ],
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 1
              },
              "exact": {
                "type": "boolean"
              },
              "laneInventories": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lane1", "lane3", "lane5"],
                "properties": {
                  "lane1": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["assemblyId", "count"],
                      "properties": {
                        "assemblyId": { "type": "string", "minLength": 1 },
                        "count": { "type": "integer", "minimum": 0 }
                      }
                    }
                  },
                  "lane3": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["assemblyId", "count"],
                      "properties": {
                        "assemblyId": { "type": "string", "minLength": 1 },
                        "count": { "type": "integer", "minimum": 0 }
                      }
                    }
                  },
                  "lane5": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["assemblyId", "count"],
                      "properties": {
                        "assemblyId": { "type": "string", "minLength": 1 },
                        "count": { "type": "integer", "minimum": 0 }
                      }
                    }
                  }
                }
              },
              "lane2Operators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "lawId", "inputOccurrenceKeys", "outputOccurrenceKeys"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "enum": ["associate", "dissociate", "pass-thru"] },
                    "lawId": { "type": ["string", "null"], "minLength": 1 },
                    "requiredSupportRows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["rowAssemblyId", "count"],
                        "properties": {
                          "rowAssemblyId": { "type": "string", "minLength": 1 },
                          "count": { "type": "integer", "minimum": 0 }
                        }
                      }
                    },
                    "inputOccurrenceKeys": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "outputOccurrenceKeys": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              "lane4Operators": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "type", "lawId", "inputOccurrenceKeys", "outputOccurrenceKeys"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "type": { "type": "string", "enum": ["associate", "dissociate", "pass-thru"] },
                    "lawId": { "type": ["string", "null"], "minLength": 1 },
                    "inputOccurrenceKeys": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "outputOccurrenceKeys": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              "provenanceSummary": {
                "type": "object",
                "additionalProperties": false,
                "required": ["summaryText", "outputs"],
                "properties": {
                  "summaryText": { "type": "string", "minLength": 1 },
                  "outputs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["occurrenceKey", "provenanceClass", "supportSourceRows", "ambiguous"],
                      "properties": {
                        "occurrenceKey": { "type": "string", "minLength": 1 },
                        "provenanceClass": {
                          "type": "string",
                          "enum": ["pass_thru", "active_rewrite", "support_derived", "mixed"]
                        },
                        "supportSourceRows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["rowAssemblyId", "count"],
                            "properties": {
                              "rowAssemblyId": { "type": "string", "minLength": 1 },
                              "count": { "type": "integer", "minimum": 0 }
                            }
                          }
                        },
                        "ambiguous": { "type": "boolean" }
                      }
                    }
                  }
                }
              },
              "solveGraph": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["schema", "units", "edges"],
                "properties": {
                  "schema": {
                    "const": "pdgsolve-publication-graph/v1"
                  },
                  "units": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "kind",
                        "lane",
                        "recipeId",
                        "occurrenceKey",
                        "title",
                        "anchorRow"
                      ],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "kind": { "type": "string", "enum": ["assembly", "operator"] },
                        "lane": { "type": "integer", "minimum": 1 },
                        "recipeId": { "type": "string", "minLength": 1 },
                        "occurrenceKey": { "type": "string", "minLength": 1 },
                        "title": { "type": "string", "minLength": 1 },
                        "anchorRow": { "type": "integer", "minimum": 0 }
                      }
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "fromUnitId", "fromPortId", "toUnitId", "toPortId"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "fromUnitId": { "type": "string", "minLength": 1 },
                        "fromPortId": { "type": "string", "minLength": 1 },
                        "toUnitId": { "type": "string", "minLength": 1 },
                        "toPortId": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state",
        "selectedFamilyId",
        "acceptedFamilyId",
        "acceptedRecord",
        "blockingDiagnostics"
      ],
      "properties": {
        "schema": {
          "const": "pdgsolve-review-state/v1"
        },
        "state": {
          "type": "string",
          "enum": ["stale", "review_ready", "accepted", "published"]
        },
        "selectedFamilyId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "acceptedFamilyId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "acceptedRecord": {
          "type": ["object", "null"]
        },
        "blockingDiagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "phase", "message", "blocking", "payload"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "phase": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "blocking": { "type": "boolean" },
              "payload": { "type": "object" }
            }
          }
        }
      }
    },
    "publication": {
      "type": ["object", "null"]
    }
  }
}
