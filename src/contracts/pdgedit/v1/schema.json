{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgedit/v1/schema.json",
  "title": "pdgedit Document v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "reactionSummaryParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pdgReactants",
        "aaaReactants",
        "pdgProducts",
        "aaaProducts"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pdgIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "pdgReactants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reactionSummaryParticipant"
          }
        },
        "aaaReactants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reactionSummaryParticipant"
          }
        },
        "pdgProducts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reactionSummaryParticipant"
          }
        },
        "aaaProducts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reactionSummaryParticipant"
          }
        }
      }
    },
    "balanceTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epsilonMinusCount",
        "epsilonPlusCount"
      ],
      "properties": {
        "epsilonMinusCount": {
          "type": "integer",
          "minimum": 0
        },
        "epsilonPlusCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "balanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reactantTotals",
        "productTotals",
        "isBalanced"
      ],
      "properties": {
        "reactantTotals": {
          "$ref": "#/$defs/balanceTotals"
        },
        "productTotals": {
          "$ref": "#/$defs/balanceTotals"
        },
        "isBalanced": {
          "type": "boolean"
        }
      }
    },
    "primitiveCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electrinoCount",
        "positrinoCount"
      ],
      "properties": {
        "electrinoCount": {
          "type": "integer",
          "minimum": 0
        },
        "positrinoCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "schema",
    "assemblies",
    "operators",
    "links",
    "compositeLabels"
  ],
  "properties": {
    "schema": {
      "const": "pdgedit/v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reactionSummary"],
      "properties": {
        "reactionSummary": {
          "$ref": "#/$defs/reactionSummary"
        },
        "balanceSummary": {
          "$ref": "#/$defs/balanceSummary"
        }
      }
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "title",
          "role",
          "tiles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "unbound-architrinos-assembly",
              "unbound-architrino-residue-e4-p8-assembly",
              "unbound-architrino-residue-e6-p6-assembly",
              "unbound-architrino-residue-e9-p3-assembly",
              "pro-tau-assembly",
              "anti-tau-assembly",
              "pro-muon-assembly",
              "anti-muon-assembly",
              "pro-electron-assembly",
              "anti-electron-assembly",
              "pro-tau-neutrino-assembly",
              "anti-tau-neutrino-assembly",
              "pro-muon-neutrino-assembly",
              "anti-muon-neutrino-assembly",
              "pro-electron-neutrino-assembly",
              "anti-electron-neutrino-assembly",
              "pro-bottom-quark-assembly",
              "anti-bottom-quark-assembly",
              "pro-strange-quark-assembly",
              "anti-strange-quark-assembly",
              "pro-down-quark-assembly",
              "anti-down-quark-assembly",
              "pro-top-quark-assembly",
              "anti-top-quark-assembly",
              "pro-charm-quark-assembly",
              "anti-charm-quark-assembly",
              "pro-up-quark-assembly",
              "anti-up-quark-assembly",
              "up-quark-color-variations-assembly",
              "down-quark-color-variations-family-i-assembly",
              "down-quark-color-variations-family-ii-assembly",
              "noether-sea-assembly",
              "pro-noether-core-assembly",
              "anti-noether-core-assembly",
              "pro-bi-binary-assembly",
              "anti-bi-binary-assembly",
              "pro-uni-binary-assembly",
              "anti-uni-binary-assembly"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "reactant",
              "intermediate",
              "product"
            ]
          },
          "orderGroup": {
            "type": "string",
            "enum": ["pdg", "aaa", "closure"]
          },
          "tiles": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sampleCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topCount", "bottomCount"],
            "properties": {
              "topCount": {
                "type": "string",
                "minLength": 1
              },
              "bottomCount": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "primitiveCounts": {
            "$ref": "#/$defs/primitiveCounts"
          }
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "x",
          "y",
          "title",
          "positrinoCount",
          "electrinoCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "associate",
              "dissociate",
              "pass-thru"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "positrinoCount": {
            "type": "integer",
            "minimum": 0
          },
          "electrinoCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "endpointA",
          "endpointB"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "endpointA": {
            "type": "string",
            "minLength": 1
          },
          "endpointB": {
            "type": "string",
            "minLength": 1
          },
          "primitiveCounts": {
            "$ref": "#/$defs/primitiveCounts"
          }
        }
      }
    },
    "compositeLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "side",
          "text",
          "rowStart",
          "rowEnd"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "photon-composite",
              "noether-pair-composite",
              "noether-quad-composite",
              "pro-proton-composite",
              "anti-proton-composite",
              "pro-neutron-composite",
              "anti-neutron-composite",
              "positive-pion-composite",
              "negative-pion-composite",
              "neutral-pion-u-composite",
              "neutral-pion-d-composite",
              "positive-kaon-composite",
              "negative-kaon-composite",
              "neutral-kaon-d-composite",
              "neutral-kaon-s-composite",
              "positive-b-meson-composite",
              "negative-b-meson-composite",
              "neutral-b-meson-d-composite",
              "neutral-b-meson-b-composite"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rowStart": {
            "type": "integer",
            "minimum": 0
          },
          "rowEnd": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
