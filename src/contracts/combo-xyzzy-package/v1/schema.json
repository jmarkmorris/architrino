{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/combo-xyzzy-package/v1/schema.json",
  "title": "Combo Xyzzy Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceAcceptanceDigest",
    "publicationMode",
    "documentId",
    "documentTitle",
    "xyzzyDocument",
    "manifestEntry"
  ],
  "properties": {
    "schema": {
      "const": "combo-xyzzy-package/v1"
    },
    "sourceAcceptanceDigest": {
      "type": "string",
      "minLength": 1
    },
    "publicationMode": {
      "type": "string",
      "enum": ["durable", "launch"]
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "documentTitle": {
      "type": "string",
      "minLength": 1
    },
    "xyzzyDocument": {
      "type": "object"
    },
    "manifestEntry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "title", "displayTitle", "documentPath"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "displayTitle": {
          "type": "string",
          "minLength": 1
        },
        "documentPath": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
