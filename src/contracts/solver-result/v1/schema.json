{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/solver-result/v1/schema.json",
  "title": "Solver Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resultId",
    "request",
    "summary",
    "participants",
    "steps",
    "mappings",
    "operators",
    "dissociation",
    "placement",
    "residue",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "solver-result/v1"
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "requestId"],
      "properties": {
        "schema": {
          "const": "solver-request/v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKind"],
          "properties": {
            "sourceKind": {
              "type": "string",
              "enum": ["reaction", "cli", "pdg-ingest", "fixture"]
            },
            "sourceDocumentId": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "upstreamContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceSchema", "reviewBoundary"],
          "properties": {
            "sourceSchema": {
              "type": "string",
              "minLength": 1
            },
            "proposalId": {
              "type": "string",
              "minLength": 1
            },
            "reviewBoundary": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "object",
              "additionalProperties": true
            },
            "contract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "upstreamSchema",
                "downstreamSchema",
                "handoffMode",
                "reactionAcceptanceRequired",
                "reactionAcceptanceBoundary",
                "acceptedReactionHandoff",
                "composerHandoff"
              ],
              "properties": {
                "upstreamSchema": { "type": "string", "minLength": 1 },
                "downstreamSchema": { "type": "string", "minLength": 1 },
                "handoffMode": { "type": "string", "minLength": 1 },
                "reactionAcceptanceRequired": { "type": "boolean" },
                "reactionAcceptanceBoundary": { "type": "string", "minLength": 1 },
                "acceptedReactionHandoff": { "type": "string", "minLength": 1 },
                "composerHandoff": { "type": "string", "minLength": 1 }
              }
            },
            "ranking": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rank", "score", "reasons"],
              "properties": {
                "rank": { "type": "integer", "minimum": 0 },
                "score": { "type": "number" },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "exact",
        "selectedPlanId",
        "unresolvedTargetCount",
        "ambiguityCount",
        "unsupportedCount"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["exact", "partial", "ambiguous", "unsupported", "no-solution"]
        },
        "exact": {
          "type": "boolean"
        },
        "selectedPlanId": {
          "type": "string",
          "minLength": 1
        },
        "unresolvedTargetCount": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguityCount": {
          "type": "integer",
          "minimum": 0
        },
        "unsupportedCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "origin",
          "side",
          "templateId",
          "label",
          "inventory",
          "rootNodeId",
          "nodes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "authored-reactant",
              "authored-product",
              "authored-center",
              "released-intermediate",
              "recruited-source",
              "operator-output",
              "solve-generated-intermediate"
            ]
          },
          "sourceParticipantId": {
            "type": "string",
            "minLength": 1
          },
          "sourceStepId": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": ["reactant", "product", "center", "intermediate"]
          },
          "templateId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "type": "string",
            "minLength": 1
          },
          "isComposite": {
            "type": "boolean"
          },
          "inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["electrinoCount", "positrinoCount"],
            "properties": {
              "electrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "positrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "familyCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["family", "count"],
                  "properties": {
                    "family": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "coreFormCounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["form", "count"],
                  "properties": {
                    "form": {
                      "type": "string",
                      "minLength": 1
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "rootNodeId": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "templateId", "label", "inventory"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "parentId": {
                  "type": "string",
                  "minLength": 1
                },
                "templateId": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "polarity": {
                  "type": "string",
                  "minLength": 1
                },
                "isComposite": {
                  "type": "boolean"
                },
                "inventory": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["electrinoCount", "positrinoCount"],
                  "properties": {
                    "electrinoCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "positrinoCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "familyCounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["family", "count"],
                        "properties": {
                          "family": {
                            "type": "string",
                            "minLength": 1
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "coreFormCounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["form", "count"],
                        "properties": {
                          "form": {
                            "type": "string",
                            "minLength": 1
                          },
                          "count": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "kind",
          "ruleFamily",
          "consumedParticipantIds",
          "producedParticipantIds",
          "resolvedTargetIds",
          "mappingIds",
          "operatorIds"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "carry-through",
              "direct-map",
              "dissociate",
              "associate",
              "recruit",
              "collapse-boson"
            ]
          },
          "ruleFamily": {
            "type": "string",
            "minLength": 1
          },
          "consumedParticipantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "producedParticipantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolvedTargetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mappingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operatorIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "diagnosticLabels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "from", "to", "provenanceMode", "conservedLedger"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["direct", "fragment", "operator-path"]
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "anchorId", "role"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "anchorId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
              },
              "anchorInstanceIndex": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "anchorId", "role"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "anchorId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
              },
              "anchorInstanceIndex": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "viaOperatorId": {
            "type": "string",
            "minLength": 1
          },
          "provenanceMode": {
            "type": "string",
            "enum": ["carry-through", "direct-conservative", "operator-mediated"]
          },
          "conservedLedger": {
            "type": "object",
            "additionalProperties": false,
            "required": ["electrinoCount", "positrinoCount"],
            "properties": {
              "electrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "positrinoCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "origin", "inputs", "outputs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["associate", "dissociate"]
          },
          "origin": {
            "type": "string",
            "enum": ["manual", "solve-generated"]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["participantId", "anchorId", "role"],
              "properties": {
                "participantId": {
                  "type": "string",
                  "minLength": 1
                },
                "anchorId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
                },
                "anchorInstanceIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["participantId", "anchorId", "role"],
              "properties": {
                "participantId": {
                  "type": "string",
                  "minLength": 1
                },
                "anchorId": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": ["reactant", "product", "center", "operator-input", "operator-output"]
                },
                "anchorInstanceIndex": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "dissociation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openedParticipantIds",
        "autoDissociatedParticipantIds",
        "releasedParticipantIds",
        "notes"
      ],
      "properties": {
        "openedParticipantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoDissociatedParticipantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "autoDissociatedParticipants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "rootNodeId", "consumedNodeIds", "remainingNodeIds"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "rootNodeId": {
                "type": "string",
                "minLength": 1
              },
              "consumedNodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "remainingNodeIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "releasedParticipantIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantPlacements", "operatorPlacements"],
      "properties": {
        "participantPlacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "placementClass", "row"],
            "properties": {
              "participantId": {
                "type": "string",
                "minLength": 1
              },
              "placementClass": {
                "type": "string",
                "enum": ["reactant", "center", "product"]
              },
              "row": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "operatorPlacements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operatorId", "lane", "row", "slot"],
            "properties": {
              "operatorId": {
                "type": "string",
                "minLength": 1
              },
              "lane": {
                "type": "integer",
                "minimum": 0
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "slot": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "residue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolvedTargetIds",
        "unusedSourceIds",
        "sourceInventory",
        "targetInventory",
        "unsupportedNotes"
      ],
      "properties": {
        "unresolvedTargetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unusedSourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["electrinoCount", "positrinoCount"],
          "properties": {
            "electrinoCount": {
              "type": "integer",
              "minimum": 0
            },
            "positrinoCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "targetInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["electrinoCount", "positrinoCount"],
          "properties": {
            "electrinoCount": {
              "type": "integer",
              "minimum": 0
            },
            "positrinoCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "unsupportedNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
