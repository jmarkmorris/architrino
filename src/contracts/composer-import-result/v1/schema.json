{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/composer-import-result/v1/schema.json",
  "title": "Composer Import Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceSchema",
    "importedReactionId",
    "sceneId",
    "warnings",
    "rejectedFeatures",
    "fallbacks"
  ],
  "properties": {
    "schema": {
      "const": "composer-import-result/v1"
    },
    "sourceSchema": {
      "const": "reaction-flow/v1"
    },
    "importedReactionId": {
      "type": "string",
      "minLength": 1
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rejectedFeatures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
