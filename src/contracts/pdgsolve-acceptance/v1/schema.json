{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgsolve-acceptance/v1/schema.json",
  "title": "pdgsolve Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problemId",
    "familyId",
    "resultDigest",
    "acceptedScore",
    "acceptedDiagnostics",
    "acceptedState",
    "lockedNormalizationSummary",
    "lockedPolicySummary",
    "lockedReactantAssemblies",
    "lockedReactantSideOperators",
    "lockedIntermediateAssemblies",
    "lockedProductSideOperators",
    "lockedProductAssemblies",
    "lockedProvenanceSummary",
    "lockedSolveGraph"
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "message", "blocking", "payload"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "payload": { "type": "object" }
      }
    },
    "countedAssemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assemblyId", "count"],
        "properties": {
          "assemblyId": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "operatorChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "lawId", "inputOccurrenceKeys", "outputOccurrenceKeys"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["associate", "dissociate", "pass-thru"] },
        "lawId": { "type": ["string", "null"], "minLength": 1 },
        "requiredSupportRows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rowAssemblyId", "count"],
            "properties": {
              "rowAssemblyId": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "inputOccurrenceKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outputOccurrenceKeys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summaryText", "outputs"],
      "properties": {
        "summaryText": {
          "type": "string",
          "minLength": 1
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["occurrenceKey", "provenanceClass", "supportSourceRows", "ambiguous"],
            "properties": {
              "occurrenceKey": { "type": "string", "minLength": 1 },
              "provenanceClass": {
                "type": "string",
                "enum": ["pass_thru", "active_rewrite", "support_derived", "mixed"]
              },
              "supportSourceRows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["rowAssemblyId", "count"],
                  "properties": {
                    "rowAssemblyId": { "type": "string", "minLength": 1 },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "ambiguous": { "type": "boolean" }
            }
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactness",
        "primitiveMismatch",
        "middleMismatch",
        "auxiliaryBurden",
        "nonIdentityOperatorCount",
        "dissociationCount",
        "ambiguityPenalty",
        "tieBreakKey"
      ],
      "properties": {
        "exactness": { "type": "integer", "minimum": 0 },
        "primitiveMismatch": { "type": "integer", "minimum": 0 },
        "middleMismatch": { "type": "integer", "minimum": 0 },
        "auxiliaryBurden": { "type": "integer", "minimum": 0 },
        "nonIdentityOperatorCount": { "type": "integer", "minimum": 0 },
        "dissociationCount": { "type": "integer", "minimum": 0 },
        "ambiguityPenalty": { "type": "integer", "minimum": 0 },
        "tieBreakKey": { "type": "string", "minLength": 1 }
      }
    },
    "publicationUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "stage",
        "recipeId",
        "occurrenceKey",
        "title",
        "anchorRow"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["assembly", "operator"] },
        "stage": {
          "type": "string",
          "enum": [
            "reactantAssemblies",
            "reactantSideOperators",
            "intermediateAssemblies",
            "productSideOperators",
            "productAssemblies"
          ]
        },
        "recipeId": { "type": "string", "minLength": 1 },
        "occurrenceKey": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "anchorRow": { "type": "integer", "minimum": 0 },
        "positrinoCount": { "type": "integer", "minimum": 0 },
        "electrinoCount": { "type": "integer", "minimum": 0 }
      }
    },
    "publicationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromUnitId", "fromPortId", "toUnitId", "toPortId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fromUnitId": { "type": "string", "minLength": 1 },
        "fromPortId": { "type": "string", "minLength": 1 },
        "toUnitId": { "type": "string", "minLength": 1 },
        "toPortId": { "type": "string", "minLength": 1 }
      }
    },
    "publicationGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "units", "edges"],
      "properties": {
        "schema": {
          "const": "pdgsolve-publication-graph/v1"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicationUnit"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicationEdge"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "pdgsolve-acceptance/v1"
    },
    "problemId": {
      "type": "string",
      "minLength": 1
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "resultDigest": {
      "type": "string",
      "minLength": 1
    },
    "acceptedScore": {
      "$ref": "#/$defs/score"
    },
    "acceptedDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "acceptedState": {
      "const": "accepted"
    },
    "lockedNormalizationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addedSupportOccurrences", "diagnostics"],
      "properties": {
        "addedSupportOccurrences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "lockedPolicySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactClosureRequired",
        "allowedBoundaryAugmentations"
      ],
      "properties": {
        "exactClosureRequired": {
          "type": "boolean"
        },
        "allowedBoundaryAugmentations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["none", "hp", "hq"]
          }
        }
      }
    },
    "lockedReactantAssemblies": {
      "$ref": "#/$defs/countedAssemblies"
    },
    "lockedReactantSideOperators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorChoice"
      }
    },
    "lockedIntermediateAssemblies": {
      "$ref": "#/$defs/countedAssemblies"
    },
    "lockedProductSideOperators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatorChoice"
      }
    },
    "lockedProductAssemblies": {
      "$ref": "#/$defs/countedAssemblies"
    },
    "lockedProvenanceSummary": {
      "$ref": "#/$defs/provenanceSummary"
    },
    "lockedSolveGraph": {
      "$ref": "#/$defs/publicationGraph"
    }
  }
}
