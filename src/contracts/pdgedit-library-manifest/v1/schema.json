{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgedit-library-manifest/v1/schema.json",
  "title": "pdgedit Library Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "defaultEntryId", "entries"],
  "properties": {
    "schema": {
      "const": "pdgedit-library-manifest/v1"
    },
    "defaultEntryId": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "displayTitle", "documentPath"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "displayTitle": {
            "type": "string",
            "minLength": 1
          },
          "documentPath": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "type": "string",
            "enum": ["example", "exact", "unsolved"]
          },
          "branchingProbability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "productUnboundArchitrinoCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["electrinoCount", "positrinoCount"],
            "properties": {
              "electrinoCount": {
                "type": "integer",
                "minimum": 0
              },
              "positrinoCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "isDefault": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
