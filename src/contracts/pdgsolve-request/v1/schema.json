{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgsolve-request/v1/schema.json",
  "title": "pdgsolve Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "source",
    "reactants",
    "products",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "pdgsolve-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["pdgfeed", "developer", "pdgsolve-reopen"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reactionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "pdgReactants",
        "aaaReactants",
        "pdgProducts",
        "aaaProducts"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pdgIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "pdgReactants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "aaaReactants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pdgProducts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "aaaProducts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "reactants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "pro_noether_swarm_I",
              "anti_noether_swarm_I",
              "pro_noether_swarm_II",
              "anti_noether_swarm_II",
              "pro_noether_swarm_III",
              "anti_noether_swarm_III",
              "pro_electron_I",
              "anti_electron_I",
              "pro_electron_neutrino_I",
              "anti_electron_neutrino_I",
              "pro_up_quark_I",
              "anti_up_quark_I",
              "pro_down_quark_I",
              "anti_down_quark_I",
              "pro_muon_II",
              "anti_muon_II",
              "pro_muon_neutrino_II",
              "anti_muon_neutrino_II",
              "pro_charm_quark_II",
              "anti_charm_quark_II",
              "pro_strange_quark_II",
              "anti_strange_quark_II",
              "pro_tau_III",
              "anti_tau_III",
              "pro_tau_neutrino_III",
              "anti_tau_neutrino_III",
              "pro_top_quark_III",
              "anti_top_quark_III",
              "pro_bottom_quark_III",
              "anti_bottom_quark_III"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "pro_noether_swarm_I",
              "anti_noether_swarm_I",
              "pro_noether_swarm_II",
              "anti_noether_swarm_II",
              "pro_noether_swarm_III",
              "anti_noether_swarm_III",
              "pro_electron_I",
              "anti_electron_I",
              "pro_electron_neutrino_I",
              "anti_electron_neutrino_I",
              "pro_up_quark_I",
              "anti_up_quark_I",
              "pro_down_quark_I",
              "anti_down_quark_I",
              "pro_muon_II",
              "anti_muon_II",
              "pro_muon_neutrino_II",
              "anti_muon_neutrino_II",
              "pro_charm_quark_II",
              "anti_charm_quark_II",
              "pro_strange_quark_II",
              "anti_strange_quark_II",
              "pro_tau_III",
              "anti_tau_III",
              "pro_tau_neutrino_III",
              "anti_tau_neutrino_III",
              "pro_top_quark_III",
              "anti_top_quark_III",
              "pro_bottom_quark_III",
              "anti_bottom_quark_III",
              "unbound_architrinos_residue"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "electrinoCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "positrinoCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactClosureRequired",
        "allowedBoundaryAugmentations"
      ],
      "properties": {
        "exactClosureRequired": {
          "type": "boolean"
        },
        "allowedBoundaryAugmentations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["none", "hp", "hq"]
          }
        }
      }
    }
  }
}
