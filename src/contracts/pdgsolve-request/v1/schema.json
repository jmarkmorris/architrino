{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/pdgsolve-request/v1/schema.json",
  "title": "pdgsolve Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "source",
    "reactants",
    "products",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "pdgsolve-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["test_case", "pdgfeed", "developer", "pdgsolve-reopen"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reactants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "electron",
              "electron_antineutrino",
              "pro_down_quark",
              "pro_up_quark"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "electron",
              "electron_antineutrino",
              "pro_down_quark",
              "pro_up_quark"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactClosureRequired",
        "allowedBoundaryAugmentations"
      ],
      "properties": {
        "exactClosureRequired": {
          "type": "boolean"
        },
        "allowedBoundaryAugmentations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["none", "hp", "hq"]
          }
        }
      }
    }
  }
}
