{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://architrino.local/contracts/combo-request/v1/schema.json",
  "title": "Combo Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "source",
    "reactants",
    "products",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "combo-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["fixture", "pdgfeed", "developer", "combo-reopen"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocumentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reactants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "2h",
              "4h",
              "electron",
              "electron_antineutrino",
              "neutron",
              "noether_pair",
              "proton"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "assemblyId", "title"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "assemblyId": {
            "type": "string",
            "enum": [
              "2h",
              "4h",
              "electron",
              "electron_antineutrino",
              "neutron",
              "noether_pair",
              "proton"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "betaSupportMode",
        "exactClosureRequired",
        "allowedBoundaryAugmentations"
      ],
      "properties": {
        "betaSupportMode": {
          "type": "string",
          "enum": ["allow-implied-noether-pair", "explicit-only"]
        },
        "exactClosureRequired": {
          "type": "boolean"
        },
        "allowedBoundaryAugmentations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["none", "2h", "4h"]
          }
        }
      }
    }
  }
}
