      "L_raw",
      "wake surface norms",
      "wake-flux rows",
      "angular power by degree",
      "spectral band power"
    ],
    "pairwiseExponent": "-log(M(R_b)/M(R_a))/log(R_b/R_a)",
    "globalFit": "unweighted-least-squares-of-log-measure-on-log-radius.v1",
    "reportedRows": [
      "pairwise exponent",
      "global exponent",
      "log-space fit residual",
      "below-floor disposition"
    ],
    "claimBoundary": "report measured scaling only; do not preassign a far-field exponent"
