  "failClosedGates": {
    "sourceSpeed": "every source speed bound is strictly below field speed",
    "rootCompleteness": "every retained event has the certified complete root ledger",
    "rootTransversality": "minimum absolute D_t is at least 1e-8",
    "minimumSeparation": "minimum source-source separation is at least 1e-8",
