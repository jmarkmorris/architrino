    "emissionFixed": {
      "phaseVariable": "epsilon=(theta-delta)-modulo-two-pi",
      "rootFunction": "H(epsilon,delta)=G(theta=epsilon+delta,delta)",
      "receiverPhaseProjection": "theta(epsilon)=epsilon+delta(epsilon)",
      "projectionDerivative": "dtheta/depsilon=(partial-G/partial-delta-at-fixed-theta)/(partial-H/partial-delta-at-fixed-epsilon)"
